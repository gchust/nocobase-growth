{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "hypotheses", "actions", "limitations"],
  "properties": {
    "summary": {"type": "string", "minLength": 1, "maxLength": 1800},
    "hypotheses": {
      "type": "array", "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["title", "explanation", "confidence", "evidence_ids", "verification"],
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 180},
          "explanation": {"type": "string", "minLength": 1, "maxLength": 1500},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
          "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "maxLength": 160}},
          "verification": {"type": "string", "minLength": 1, "maxLength": 800}
        }
      }
    },
    "actions": {
      "type": "array", "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["priority", "title", "target_urls", "reason", "effort", "acceptance", "evidence_ids"],
        "properties": {
          "priority": {"type": "integer", "minimum": 1, "maximum": 3},
          "title": {"type": "string", "minLength": 1, "maxLength": 180},
          "target_urls": {"type": "array", "maxItems": 5, "items": {"type": "string", "maxLength": 2000}},
          "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
          "effort": {"type": "string", "enum": ["small", "medium", "large"]},
          "acceptance": {"type": "string", "minLength": 1, "maxLength": 800},
          "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "maxLength": 160}}
        }
      }
    },
    "limitations": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
  }
}
